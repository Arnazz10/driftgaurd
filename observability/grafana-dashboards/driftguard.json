{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(driftguard_http_requests_total[2m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(driftguard_http_requests_total{status=~\"5..\"}[2m])) by (service) / clamp_min(sum(rate(driftguard_http_requests_total[2m])) by (service), 1)",
          "legendFormat": "{{service}}"
        }
      ],
      "title": "5xx Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(driftguard_http_request_duration_seconds_bucket[2m])) by (service, le))",
          "legendFormat": "{{service}} p95"
        }
      ],
      "title": "p95 Latency",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["driftguard", "gitops", "rollouts"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "title": "DriftGuard Services",
  "uid": "driftguard-services",
  "version": 1
}

